{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quotebot/pricing-rules.schema.json",
  "title": "Quotebot pricing rules (one per client)",
  "type": "object",
  "required": ["client_id", "rules_version", "signed_off_by_owner", "business", "estimate_policy", "fields", "services"],
  "additionalProperties": false,
  "$defs": {
    "condition": {
      "type": "object",
      "required": ["field"],
      "additionalProperties": false,
      "properties": {
        "field": { "type": "string" },
        "equals": {},
        "in": { "type": "array" }
      },
      "oneOf": [{ "required": ["equals"] }, { "required": ["in"] }]
    }
  },
  "properties": {
    "client_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "rules_version": { "type": "string" },
    "signed_off_by_owner": { "type": "boolean" },
    "_note": { "type": "string" },
    "business": {
      "type": "object",
      "required": ["name", "service_zips"],
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "service_zips": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{5}$" }, "minItems": 1 },
        "hours": { "type": "string" }
      }
    },
    "estimate_policy": {
      "type": "object",
      "required": ["range_low_pct", "range_high_pct", "round_to", "minimum_job", "disclaimer"],
      "additionalProperties": false,
      "properties": {
        "range_low_pct": { "type": "number", "minimum": 0, "maximum": 0.5 },
        "range_high_pct": { "type": "number", "minimum": 0, "maximum": 1 },
        "round_to": { "type": "number", "exclusiveMinimum": 0 },
        "minimum_job": { "type": "number", "minimum": 0 },
        "disclaimer": { "type": "string", "minLength": 10 }
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "required"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": ["enum", "number", "string", "boolean"] },
          "options": { "type": "array", "items": { "type": "string" } },
          "required": { "type": "boolean" },
          "ask": { "type": ["string", "null"] }
        }
      }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "unit", "unit_price", "max_quantity"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "unit": { "enum": ["each", "sq_ft", "linear_ft", "hour", "job"] },
          "unit_price": { "type": "number", "minimum": 0 },
          "max_quantity": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "modifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "when"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "when": { "$ref": "#/$defs/condition" },
          "multiply": { "type": "number", "exclusiveMinimum": 0 },
          "add": { "type": "number" }
        },
        "oneOf": [{ "required": ["multiply"] }, { "required": ["add"] }]
      }
    },
    "fees": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "amount"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "amount": { "type": "number", "minimum": 0 }
        }
      }
    },
    "escalate_if": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["when", "reason"],
        "additionalProperties": false,
        "properties": {
          "when": { "$ref": "#/$defs/condition" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
