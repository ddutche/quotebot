# Copy to .env.local for local work. NEVER commit real values.
# In production these live only in Vercel / Supabase settings.
# Anything WITHOUT the NEXT_PUBLIC_ prefix must never reach browser code.

# Chatbot model (pick one route)
OPENROUTER_API_KEY=
# MOONSHOT_API_KEY=
# Model id on OpenRouter (swap here to test other models)
CHAT_MODEL=moonshotai/kimi-k2.6

# GPT checker (testing + sampled production chats)
OPENAI_API_KEY=
# Fill in the newest GPT model id when you set this up
JUDGE_MODEL=

# Supabase (newer projects call these publishable/secret keys; older ones call them anon/service_role)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key: safe in the browser ONLY because RLS is on for every table
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: server only, bypasses RLS
SUPABASE_SECRET_KEY=

# Email lead alerts (Resend free tier to start)
RESEND_API_KEY=
# Sender address must be on a domain verified in Resend
LEAD_ALERT_FROM=alerts@your-domain.com

# Spending caps are set in each provider's dashboard, not here.
# Record them in README.md > Spending caps.
