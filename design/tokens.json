{
  "_note": "Base design tokens. Every client uses these. A client can only override what's listed in clients/<id>/brand.json. Never hard-code a color, size, or font in a component.",
  "color": {
    "surface": "#FFFFFF",
    "surface-muted": "#F6F7F9",
    "text": "#16181D",
    "text-muted": "#5B6270",
    "border": "#E3E6EB",
    "success": "#1E7A46",
    "warning": "#A15C00",
    "danger": "#B42318",
    "brand": "{brand.primary_color}",
    "brand-contrast": "{computed: #FFFFFF or #16181D, whichever passes 4.5:1 on brand}",
    "brand-soft": "{computed: brand at 10% over surface}"
  },
  "font": {
    "family": "{brand.font or 'Inter'}",
    "fallback": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "allowed_families": ["Inter", "Source Sans 3", "Nunito Sans", "Work Sans", "IBM Plex Sans"]
  },
  "type_scale_px": { "xs": 12, "sm": 14, "base": 16, "lg": 18, "xl": 22, "2xl": 28, "3xl": 36 },
  "line_height": { "tight": 1.2, "normal": 1.5 },
  "weight": { "regular": 400, "medium": 500, "bold": 700 },
  "space_px": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 64 },
  "radius_px": {
    "rounded": { "sm": 6, "md": 10, "lg": 16, "pill": 999 },
    "square": { "sm": 2, "md": 4, "lg": 6, "pill": 6 }
  },
  "shadow": {
    "panel": "0 8px 24px rgba(22, 24, 29, 0.12)",
    "button": "0 1px 2px rgba(22, 24, 29, 0.08)"
  },
  "layout": {
    "widget_width_px": 380,
    "widget_max_height_vh": 80,
    "mobile_breakpoint_px": 640,
    "page_max_width_px": 1080,
    "tap_target_min_px": 44
  },
  "motion_ms": { "fast": 120, "normal": 200 }
}
