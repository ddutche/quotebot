{
  "name": "quotebot-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Starter kit for Quotebot: one template, one config per client.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:widget": "node scripts/build-widget.mjs",
    "predev": "node scripts/build-widget.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/build-widget.mjs",
    "build": "next build",
    "start": "next start",
    "test": "node --test engine/engine.test.js \"lib/**/*.test.js\"",
    "golden": "node validator/run-golden.js clients/example-drywall",
    "live": "node --env-file-if-exists=.env.local validator/run-live.js clients/example-drywall",
    "push-rules": "node --env-file-if-exists=.env.local scripts/push-rules.mjs"
  },
  "dependencies": {
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
